+
+void AutoMxPrecPragmaHandler::HandlePragma(Preprocessor &PP,
+                                           PragmaIntroducer Introducer,
+                                           Token &Tok) {
+  auto *Info = new (PP.getPreprocessorAllocator()) AutoMxPrecInfo;
+  // 验证初始token是否为"AutoMxPrec"标识符
+  assert(Tok.is(tok::identifier));
+  if (Tok.getIdentifierInfo()->getName() != "AutoMxPrec") return;
+
+  Info->AutoMxPrec = Tok;
+
+  // 创建一个新的annotation token
+  Token AutoMxPrecTok;
+  AutoMxPrecTok.startToken();
+  AutoMxPrecTok.setKind(tok::annot_pragma_AutoMxPrec);
+  AutoMxPrecTok.setLocation(Tok.getLocation());
+  AutoMxPrecTok.setAnnotationEndLoc(Tok.getLocation());
+  AutoMxPrecTok.setAnnotationValue(Info);
+
+  // 检查是否在指令之后有额外的token
+  PP.Lex(Tok);
+  if (Tok.isNot(tok::eod)) {
+    PP.Diag(Tok.getLocation(), diag::warn_pragma_extra_tokens_at_eol)
+      << "AutoMxPrec";
+    return;
+  }
+
+  // 创建一个包含新annotation token的数组
+  auto TokenArray = std::make_unique<Token[]>(1);
+  TokenArray[0] = AutoMxPrecTok;
+
+  // 将新的token数组注入到token流中
+  PP.EnterTokenStream(std::move(TokenArray), 1,
+                      /*DisableMacroExpansion=*/false, /*IsReinject=*/false);
+}
