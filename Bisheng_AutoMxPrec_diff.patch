+
+StmtResult Parser::ParsePragmaAutoMxPrec(StmtVector &Stmts,
+                                              ParsedStmtContext StmtCtx,
+                                              SourceLocation *TrailingElseLoc,
+                                              ParsedAttributes &Attrs) {
+  assert(Tok.is(tok::annot_pragma_AutoMxPrec));
+
+  auto Command = static_cast<AutoMxPrecInfo *>(Tok.getAnnotationValue())->AutoMxPrec;
+
+  // 创建存储AutoMxPrecStart属性的ParsedAttributes对象
+  ParsedAttributes AutoMxPrecAttrs(AttrFactory);
+  // 创建一个新的属性并添加到AutoMxPrec属性容器中
+  AutoMxPrecAttrs.addNew(Command.getIdentifierInfo(), Command.getLocation(), nullptr, {}, nullptr,
+                              0, ParsedAttr::Form::Pragma());
+
+  // 消耗掉当前的annotation token
+  ConsumeAnnotationToken();
+  // 解析pragma之后的任何C++11属性
+  MaybeParseCXX11Attributes(Attrs);
+  // 创建一个空的ParsedAttributes对象，用于存储函数声明规范属性
+  ParsedAttributes EmptyDeclSpecAttrs(AttrFactory);
+  // 解析pragma之后的语句或声明
+  StmtResult S = ParseStatementOrDeclarationAfterAttributes(
+      Stmts, StmtCtx, TrailingElseLoc, Attrs, EmptyDeclSpecAttrs);
+  Attrs.takeAllFrom(AutoMxPrecAttrs);
+  return S;
+}
