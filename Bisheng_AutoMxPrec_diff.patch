+// 实现并获取其调用，subName传入start或end
+llvm::Function* CodeGenFunction::getAutoMxPrecFunction(std::string subName)
+{
+  auto& M = CGM.getModule();
+  auto& C = M.getContext();
+  // If found decl, return immediately
+  std::string funcName = "AutoMxPrec_" + subName;
+  if (auto* F = M.getFunction(funcName.c_str())) {
+    return F;
+  }
+  // Create decl
+  auto* FT = llvm::FunctionType::get(llvm::Type::getVoidTy(C), false);
+  auto* F = llvm::Function::Create(FT, llvm::Function::ExternalLinkage, funcName, M);
+  // Create impl, ret void immediately
+  llvm::BasicBlock* BB = llvm::BasicBlock::Create(C, "entry", F);
+  llvm::IRBuilder<> Builder(BB);
+  Builder.CreateRetVoid();
+  return F;
+}
