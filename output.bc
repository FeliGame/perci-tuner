; ModuleID = 'output.bc'
source_filename = "llvm-link"
target datalayout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128"
target triple = "aarch64-unknown-linux-gnu"

%struct.MY_STRUCT = type { double, [2 x float], ptr }

@global_struct = dso_local global %struct.MY_STRUCT zeroinitializer, align 8, !dbg !0
@.str = private unnamed_addr constant [15 x i8] c"main.c output:\00", align 1, !dbg !5
@.str.1 = private unnamed_addr constant [5 x i8] c"%lf\0A\00", align 1, !dbg !11
@__const.fp_test.c = private unnamed_addr constant [2 x double] [double 1.000000e-01, double 3.000000e-01], align 8

; Function Attrs: noinline nounwind optnone uwtable
define dso_local i32 @comp_test(i32 noundef %0, i32 noundef %1) #0 !dbg !45 {
  %3 = alloca i32, align 4
  %4 = alloca i32, align 4
  %5 = alloca %struct.MY_STRUCT, align 8
  %6 = alloca ptr, align 8
  %7 = alloca ptr, align 8
  store i32 %0, ptr %3, align 4
  call void @llvm.dbg.declare(metadata ptr %3, metadata !48, metadata !DIExpression()), !dbg !49
  store i32 %1, ptr %4, align 4
  call void @llvm.dbg.declare(metadata ptr %4, metadata !50, metadata !DIExpression()), !dbg !51
  call void @llvm.dbg.declare(metadata ptr %5, metadata !52, metadata !DIExpression()), !dbg !53
  call void @llvm.dbg.declare(metadata ptr %6, metadata !54, metadata !DIExpression()), !dbg !56
  store ptr %5, ptr %6, align 8, !dbg !56
  call void @llvm.dbg.declare(metadata ptr %7, metadata !57, metadata !DIExpression()), !dbg !59
  store ptr %6, ptr %7, align 8, !dbg !59
  %8 = load i32, ptr %3, align 4, !dbg !60
  %9 = load i32, ptr %4, align 4, !dbg !61
  %10 = sub nsw i32 %8, %9, !dbg !62
  %11 = sitofp i32 %10 to float, !dbg !60
  %12 = load float, ptr getelementptr inbounds (%struct.MY_STRUCT, ptr @global_struct, i32 0, i32 1), align 8, !dbg !63
  %13 = fadd float %11, %12, !dbg !64
  %14 = fpext float %13 to double, !dbg !60
  %15 = load ptr, ptr %6, align 8, !dbg !65
  %16 = getelementptr inbounds %struct.MY_STRUCT, ptr %15, i32 0, i32 0, !dbg !66
  %17 = load double, ptr %16, align 8, !dbg !66
  %18 = fsub double %14, %17, !dbg !67
  %19 = fptosi double %18 to i32, !dbg !60
  ret i32 %19, !dbg !68
}

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare void @llvm.dbg.declare(metadata, metadata, metadata) #1

; Function Attrs: noinline nounwind optnone uwtable
define dso_local double @fun() #0 !dbg !69 {
  %1 = alloca i32, align 4
  call void @llvm.dbg.declare(metadata ptr %1, metadata !70, metadata !DIExpression()), !dbg !71
  store i32 10, ptr %1, align 4, !dbg !71
  %2 = call double @fp_test(), !dbg !72
  %3 = load i32, ptr %1, align 4, !dbg !73
  %4 = sitofp i32 %3 to double, !dbg !73
  %5 = fsub double %2, %4, !dbg !74
  ret double %5, !dbg !75
}

; Function Attrs: noinline nounwind optnone uwtable
define internal double @fp_test() #0 !dbg !18 {
  %1 = alloca fp128, align 16
  %2 = alloca fp128, align 16
  %3 = alloca fp128, align 16
  %4 = alloca [2 x double], align 8
  call void @llvm.dbg.declare(metadata ptr %1, metadata !76, metadata !DIExpression()), !dbg !78
  store fp128 0xL000000000000000040008CCCCC000000, ptr %1, align 16, !dbg !78
  call void @llvm.dbg.declare(metadata ptr %2, metadata !79, metadata !DIExpression()), !dbg !80
  store fp128 0xL00000000000000003FFD99999A000000, ptr %2, align 16, !dbg !80
  call void @llvm.dbg.declare(metadata ptr %3, metadata !81, metadata !DIExpression()), !dbg !82
  store fp128 0xL600000000000000040040A6666666666, ptr %3, align 16, !dbg !82
  call void @llvm.dbg.declare(metadata ptr %4, metadata !83, metadata !DIExpression()), !dbg !85
  call void @llvm.memcpy.p0.p0.i64(ptr align 8 %4, ptr align 8 @__const.fp_test.c, i64 16, i1 false), !dbg !85
  %5 = load fp128, ptr %1, align 16, !dbg !86
  %6 = load fp128, ptr %2, align 16, !dbg !87
  %7 = getelementptr inbounds [2 x double], ptr %4, i64 0, i64 0, !dbg !88
  %8 = load double, ptr %7, align 8, !dbg !88
  %9 = fpext double %8 to fp128, !dbg !88
  %10 = call fp128 @llvm.fmuladd.f128(fp128 %6, fp128 %9, fp128 %5), !dbg !89
  %11 = fptrunc fp128 %10 to double, !dbg !86
  ret double %11, !dbg !90
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: readwrite)
declare void @llvm.memcpy.p0.p0.i64(ptr noalias nocapture writeonly, ptr noalias nocapture readonly, i64, i1 immarg) #2

; Function Attrs: nocallback nofree nosync nounwind speculatable willreturn memory(none)
declare fp128 @llvm.fmuladd.f128(fp128, fp128, fp128) #1

; Function Attrs: noinline nounwind optnone uwtable
define dso_local i32 @main() #0 !dbg !91 {
  %1 = alloca float, align 4
  %2 = alloca ptr, align 8
  call void @llvm.dbg.declare(metadata ptr %1, metadata !94, metadata !DIExpression()), !dbg !96
  store float 3.200000e+01, ptr %1, align 4, !dbg !96
  call void @llvm.dbg.declare(metadata ptr %2, metadata !97, metadata !DIExpression()), !dbg !100
  store ptr @.str, ptr %2, align 8, !dbg !100
  %3 = call double @fun(), !dbg !101
  %4 = call i32 (ptr, ...) @printf(ptr noundef @.str.1, double noundef %3), !dbg !102
  ret i32 0, !dbg !103
}

declare i32 @printf(ptr noundef, ...) #3

attributes #0 = { noinline nounwind optnone uwtable "frame-pointer"="non-leaf" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="generic" "target-features"="+fp-armv8,+neon,+outline-atomics,+v8a,-fmv" }
